{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "Task API in plain PHP with PostgreSQL. Every request needs the `X-API-Key` header (boss key, worker key, or a key generated by `POST /worker`). Request bodies must be JSON. Errors always come as `{\"error\": \"message\"}`.\n\nThe key is checked before the route: without a valid key every path (even unknown ones) answers `401`. Unknown routes answer `404 Route not found`; known routes with an unsupported method answer `405` with an `Allow` header."
  },
  "servers": [
    { "url": "http://localhost:8000", "description": "Local (php -S localhost:8000)" }
  ],
  "security": [
    { "ApiKey": [] }
  ],
  "tags": [
    { "name": "Tasks" },
    { "name": "Workers" },
    { "name": "Bosses" }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks (paginated)",
        "description": "Tasks ordered by `id`. A page past the last one returns `200` with `data: []`.",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of tasks",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TaskList" } }
            }
          },
          "400": {
            "description": "Invalid `page` or `per_page`",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "page": { "value": { "error": "The page must be a positive integer" } },
                  "per_page": { "value": { "error": "The per_page must be an integer between 1 and 100" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/task": {
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "description": "New tasks always start with status `pending`. Fields are checked in this order and only the first error is returned: `boss_id`, `worker_id`, then `title`/`description`. `title` is trimmed.",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskInput" },
              "examples": {
                "withWorker": {
                  "summary": "With a worker",
                  "value": { "title": "Review contract", "description": "Check the new clauses", "boss_id": 1, "worker_id": 2 }
                },
                "withoutWorker": {
                  "summary": "Without a worker",
                  "value": { "title": "Plan sprint", "boss_id": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": {
            "description": "Invalid body or fields",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "invalidJson": { "value": { "error": "Invalid JSON body" } },
                  "bossId": { "value": { "error": "The boss_id isn't interger" } },
                  "workerId": { "value": { "error": "The worker_id isn't interger" } },
                  "title": { "value": { "error": "The title is required" } },
                  "types": { "value": { "error": "The title and description must be strings" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Boss or worker not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "boss": { "value": { "error": "Boss with id 99 not found" } },
                  "worker": { "value": { "error": "Worker with id 99 not found" } }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/task/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get a task by id",
        "operationId": "getTask",
        "parameters": [ { "$ref": "#/components/parameters/Id" } ],
        "responses": {
          "200": {
            "description": "The task",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": {
            "description": "Id is not an integer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "The task id isn't integer" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Task with id 99 not found" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/worker": {
      "post": {
        "tags": ["Workers"],
        "summary": "Create a worker (boss only)",
        "description": "Only the boss key can call this route. The response carries the worker's new `api_key`, shown only once: the API stores just its SHA-256 hash. `name` and `email` are trimmed and `email` is stored lowercase.",
        "operationId": "createWorker",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PersonInput" },
              "example": { "name": "Maria Oliveira", "email": "maria.oliveira@example.com" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Worker created, with its API key",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkerCreated" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidPerson" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "The key is not the boss key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Access Denied" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/EmailConflict" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/worker/{id}": {
      "get": {
        "tags": ["Workers"],
        "summary": "Get a worker by id",
        "operationId": "getWorker",
        "parameters": [ { "$ref": "#/components/parameters/Id" } ],
        "responses": {
          "200": {
            "description": "The worker (never includes the API key)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Person" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidWorkerId" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/WorkerNotFound" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      },
      "put": {
        "tags": ["Workers"],
        "summary": "Replace a worker's data",
        "description": "Always send both `name` and `email`, with the same rules as `POST /worker`. Checked in this order: id, `name`, `email`, then whether the worker exists.",
        "operationId": "updateWorker",
        "parameters": [ { "$ref": "#/components/parameters/Id" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PersonInput" },
              "example": { "name": "Ana Silva Souza", "email": "ana.silva@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated worker",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Person" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidPerson" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/WorkerNotFound" },
          "409": { "$ref": "#/components/responses/EmailConflict" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/boss": {
      "post": {
        "tags": ["Bosses"],
        "summary": "Create a boss",
        "description": "Same rules as `POST /worker`, but no API key is generated. Boss and worker emails are independent.",
        "operationId": "createBoss",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PersonInput" },
              "example": { "name": "Test Boss", "email": "test.boss@example.com" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Boss created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Person" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidPerson" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/EmailConflict" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    },
    "/boss/{id}": {
      "get": {
        "tags": ["Bosses"],
        "summary": "Get a boss by id",
        "operationId": "getBoss",
        "parameters": [ { "$ref": "#/components/parameters/Id" } ],
        "responses": {
          "200": {
            "description": "The boss",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Person" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidBossId" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/BossNotFound" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      },
      "put": {
        "tags": ["Bosses"],
        "summary": "Replace a boss's data",
        "description": "Always send both `name` and `email`, with the same rules as `POST /boss`.",
        "operationId": "updateBoss",
        "parameters": [ { "$ref": "#/components/parameters/Id" } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PersonInput" },
              "example": { "name": "Fernando Alves", "email": "fernando.alves@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated boss",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Person" } }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidPerson" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/BossNotFound" },
          "409": { "$ref": "#/components/responses/EmailConflict" },
          "500": { "$ref": "#/components/responses/DatabaseError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Boss key, worker key (both from .env), or a key generated by POST /worker"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "maxLength": 150, "example": "Create login page" },
          "description": { "type": "string", "nullable": true, "example": "Build the login form with validation." },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done"], "example": "pending" },
          "created": { "type": "string", "description": "Timestamp, e.g. 2026-10-29 14:05:12.481203", "example": "2026-10-29 14:05:12.481203" },
          "modified": { "type": "string", "example": "2026-10-29 14:05:12.481203" },
          "worker": { "type": "string", "nullable": true, "description": "Worker's name (not id)", "example": "Ana Silva" },
          "boss": { "type": "string", "nullable": true, "description": "Boss's name (not id)", "example": "Fernando Alves" }
        }
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "page": { "type": "integer", "example": 1 },
          "per_page": { "type": "integer", "example": 20 },
          "total": { "type": "integer", "description": "Total number of tasks", "example": 8 }
        }
      },
      "TaskInput": {
        "type": "object",
        "required": ["title", "boss_id"],
        "properties": {
          "title": { "type": "string", "maxLength": 150, "description": "Trimmed; blank counts as missing" },
          "boss_id": { "type": "integer", "description": "Also accepted as a numeric string" },
          "worker_id": { "type": "integer", "nullable": true, "description": "Optional; omit (or send empty) for a task without a worker" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Person": {
        "type": "object",
        "description": "A worker or a boss",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "maxLength": 100, "example": "Ana Silva" },
          "email": { "type": "string", "format": "email", "maxLength": 150, "example": "ana.silva@example.com" },
          "created": { "type": "string", "example": "2026-10-29 14:05:12.481203" }
        }
      },
      "WorkerCreated": {
        "allOf": [
          { "$ref": "#/components/schemas/Person" },
          {
            "type": "object",
            "properties": {
              "api_key": { "type": "string", "description": "64 hex characters. Returned only once.", "example": "3f9c0e7a1b2d4c5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6" }
            }
          }
        ]
      },
      "PersonInput": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string", "maxLength": 100, "description": "Trimmed" },
          "email": { "type": "string", "format": "email", "maxLength": 150, "description": "Trimmed and stored lowercase; must be unique" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, empty or invalid `X-API-Key`",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Invalid or missing API key" }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Method not supported on this route; see the `Allow` header",
        "headers": {
          "Allow": { "schema": { "type": "string" }, "example": "GET, POST" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Method not allowed" }
          }
        }
      },
      "DatabaseError": {
        "description": "Database failure",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "query": { "value": { "error": "Database error" } },
              "connection": { "value": { "error": "Database connection failed", "code": 7 } }
            }
          }
        }
      },
      "InvalidPerson": {
        "description": "Invalid id, body or fields (only the first error is returned)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "invalidJson": { "value": { "error": "Invalid JSON body" } },
              "nameRequired": { "value": { "error": "The name is required" } },
              "nameLength": { "value": { "error": "The name must have at most 100 characters" } },
              "emailInvalid": { "value": { "error": "The email isn't valid" } },
              "emailLength": { "value": { "error": "The email must have at most 150 characters" } },
              "types": { "value": { "error": "The name and email must be strings" } }
            }
          }
        }
      },
      "EmailConflict": {
        "description": "Email already registered",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Email already registered" }
          }
        }
      },
      "InvalidWorkerId": {
        "description": "Id is not an integer",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "The worker_id isn't interger" }
          }
        }
      },
      "WorkerNotFound": {
        "description": "Worker not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Worker with id 99 not found" }
          }
        }
      },
      "InvalidBossId": {
        "description": "Id is not an integer",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "The boss_id isn't interger" }
          }
        }
      },
      "BossNotFound": {
        "description": "Boss not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Boss with id 99 not found" }
          }
        }
      }
    }
  }
}
