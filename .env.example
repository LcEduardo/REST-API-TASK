# Copie este arquivo para .env e preencha com as suas credenciais.
# O .env NÃO vai para o git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task
DB_USER=postgres
DB_PASS=

TOKEN_TELEGRAM=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Chaves da API, enviadas no header X-API-Key. Gere com: php -r "echo bin2hex(random_bytes(32));"
API_SECRET_KEY_BOSS=
API_SECRET_KEY_WORKER=
